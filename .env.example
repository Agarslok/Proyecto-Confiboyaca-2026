# Persistencia de esta versión. "memory" guarda en el proceso del servidor y se pierde al reiniciarlo.
# El recorrido que ve el usuario vive en localStorage del navegador.
DATA_PROVIDER=memory

# Reservado para una cuenta propia de Supabase. No rellenar con claves de ejemplo.
# DATA_PROVIDER=supabase
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# Diagnóstico. "rules" funciona sin red. "gemini" aún no está implementado y el servicio lo rechaza.
DIAGNOSIS_PROVIDER=rules

# Radar IA: dónde se guardan los diagnósticos.
#   sqlite   (por defecto) archivo local, para trabajar en un computador.
#   supabase para Netlify u otro hosting sin disco fijo. Ver docs/DESPLIEGUE.md.
RADAR_STORE=sqlite
# Con RADAR_STORE=supabase (llave secreta del proyecto, solo en el servidor):
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SECRET_KEY=

# Con RADAR_STORE=sqlite: ruta opcional del archivo; por defecto data/radar.db.
# Recomendado fuera de carpetas sincronizadas (OneDrive, Drive) para evitar bloqueos del archivo.
# RADAR_DB_PATH=C:\RadarIA\radar.db

# Panel de consultores (/consultor). Copie estas líneas a .env.local con valores propios.
# CONSULTOR_PASSWORD: mínimo 10 caracteres, compartida por el equipo.
# SESSION_SECRET: mínimo 32 caracteres al azar. Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONSULTOR_PASSWORD=
SESSION_SECRET=
